    return a + b
def subtract(a, b):#Function for subtraction
    return a - b
def multiply(a, b):#Function for multiplication
    return a * b
def divide(a, b):#Function for division
    if b != 0:#If the divisor is assigned as zero, the function detects it and then prints an error message
        return a / b

    else:
        return "Error: division by zero"#Error message

operation = input("Choose an operation, either (A(Addition), S(Subtraction), M(Multiplication), or D(Division)): ")#Asks user for the operation to be used

if operation == "A" or operation == "a":#Conditional function for addition
